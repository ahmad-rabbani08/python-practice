day 30 -------------------------------------------------------------------------------------------------------------- recursion function 
factorial(n) = n*factorial(n-1)
def factorial(n):
    if (n==0 or n==1):
        return 1
    else:
        return n*factorial(n-1)
print(factorial(5))
def fibanaci(n):
    if(n<=1):
        return n
    else:
        return fibanaci(n-1) + fibanaci(n-2)
print(fibanaci(4))
